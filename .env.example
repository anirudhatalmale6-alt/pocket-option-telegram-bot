# ---- Copy this file to .env and fill in your values ----

# === Pocket Option ===
# Your browser SSID auth payload. LEAVE BLANK to run the offline paper simulator.
# See docs/SETUP.md for exactly how to copy it. START ON DEMO (isDemo:1).
PO_SSID=
PO_DEMO=true
PO_ASSET=EURUSD_otc
PO_EXPIRY_SECONDS=60          # 60=1m, 180=3m ... up to 3600=1h

# === Telegram ===
# Create a bot with @BotFather to get the token; get your chat id from @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === Trading loop ===
CANDLE_TIMEFRAME=60           # seconds per candle used for signals

# === Risk / money management ===
BASE_STAKE=1.0
DAILY_LOSS_CAP=20.0           # stop trading after this net loss
DAILY_PROFIT_TARGET=0.0       # 0 = disabled

# === Martingale (off by default) ===
MARTINGALE_ENABLED=false
MARTINGALE_MULTIPLIER=2.0
MARTINGALE_MAX_STEPS=2
