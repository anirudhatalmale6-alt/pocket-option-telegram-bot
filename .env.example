# ---- Copy this file to .env and fill in your values ----

# === Pocket Option ===
# Your browser SSID auth payload. LEAVE BLANK to run the offline paper simulator.
# See docs/SETUP.md for exactly how to copy it. START ON DEMO (isDemo:1).
# It must be the TRADING socket's line (the one whose reply is "successauth") —
# the chart socket's token looks similar but cannot trade. The bot checks this
# for you at start-up and says so if you pasted the wrong one.
PO_SSID=
# Easier alternative to PO_SSID: the ci_session cookie value (DevTools ->
# Application -> Cookies) plus your numeric account id. Fill in EITHER
# PO_SSID, OR these two.
PO_SESSION=
PO_UID=
PO_DEMO=true
PO_ASSET=EURUSD_otc
PO_EXPIRY_SECONDS=60          # 60=1m, 180=3m ... up to 3600=1h

# === Browser control panel (the simple way to run the bot) ===
# Open http://<your-server>:8080 in any browser: START/STOP buttons, settings,
# live trade list. Nothing to install.
WEB_ENABLED=true
WEB_HOST=0.0.0.0              # 0.0.0.0 = reachable from other devices on the network
WEB_PORT=8080
WEB_PASSWORD=                 # SET THIS on a public VPS — the panel can start trading

# === Telegram (completely optional) ===
# Leave TELEGRAM_TOKEN blank to run without Telegram at all.
# Create a bot with @BotFather to get the token; get your chat id from @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === Trading loop ===
CANDLE_TIMEFRAME=60           # seconds per candle used for signals (30 = 30s candles)
POLL_INTERVAL=1.0             # seconds between checks; leave at 1.0 for real trading

# === Strategy ===
# pullback | linreg | ema | donchian | custom | alligator | rsi | confluence
STRATEGY_MODE=confluence

# === Risk / money management ===
BASE_STAKE=1.0
DAILY_LOSS_CAP=20.0           # stop trading after this net loss
DAILY_PROFIT_TARGET=0.0       # 0 = disabled

# === Martingale (off by default) ===
MARTINGALE_ENABLED=false
MARTINGALE_MULTIPLIER=2.0
MARTINGALE_MAX_STEPS=2
